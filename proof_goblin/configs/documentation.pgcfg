{
  "format": "proof-goblin-config",
  "schema_version": "1.0",
  "name": "documentation",
  "version": "0.4.0",
  "description": "Reusable lenses and reviews for writing, understanding, maintaining, securing, and improving the accessibility of documentation.",
  "lenses": {
    "business_owner": {
      "description": "A business-operations perspective grounded in organizational responsibilities, customer needs, and day-to-day work, without assuming software-development knowledge.",
      "circumstances": [
        "The documentation is evaluated for whether a capability and its business relevance can be understood",
        "The decision context may involve limited time and comparison among several possible courses of action",
        "Software terminology, acronyms, and implementation details may not be familiar to the intended audience",
        "Enough context is needed to support a confident decision or next step"
      ],
      "knowledge": [
        "Business operations, customer needs, costs, risks, and organizational responsibilities are treated as available context",
        "Django, Python, APIs, deployment, and software architecture are not assumed knowledge"
      ],
      "goals": [
        "Understand what the documented capability enables",
        "Understand why it is relevant and what outcome to expect",
        "Identify what the business or user must provide, decide, or do",
        "Recognize prerequisites, constraints, risks, and the next step"
      ],
      "routinely_notices": [
        "Unexplained technical language",
        "Unclear business outcomes",
        "Hidden responsibilities, costs, or risks",
        "Missing examples or context needed to make a decision"
      ],
      "perspective_guardrails": [
        "Do not confuse a lack of software expertise with a lack of intelligence or domain expertise",
        "Do not demand technical implementation detail unless its absence prevents a business decision"
      ]
    },
    "django_python_developer": {
      "description": "A Python and Django implementation-and-operations perspective grounded in the demands of integrating, operating, and extending production software.",
      "circumstances": [
        "The documentation is evaluated for implementation, integration, configuration, testing, and troubleshooting",
        "Examples and instructions are expected to be precise enough to follow without guessing",
        "Assumptions, contracts, failure modes, and operational consequences must be visible"
      ],
      "knowledge": [
        "Python packaging, typing, testing, and common library conventions",
        "Django models, settings, management commands, requests, templates, and deployment concerns",
        "HTTP, APIs, databases, source control, CI, and production operations"
      ],
      "goals": [
        "Implement or integrate the capability correctly",
        "Identify required dependencies, settings, inputs, and lifecycle steps",
        "Understand public contracts, errors, edge cases, and compatibility assumptions",
        "Know how to test, diagnose, secure, and operate the result"
      ],
      "routinely_notices": [
        "Ambiguous API shapes, types, return values, and ownership boundaries",
        "Missing imports, settings, commands, prerequisites, or version assumptions",
        "Examples that are incomplete, inconsistent, or unlikely to run as written",
        "Unexplained failure modes, security implications, and operational edge cases"
      ],
      "perspective_guardrails": [
        "Do not request low-level detail that is unrelated to using or maintaining the documented capability",
        "Distinguish a genuine implementation blocker from a reasonable convention an experienced developer can infer"
      ]
    },
    "technical_writer": {
      "description": "A technical-writing perspective focused on audience fit, information architecture, clarity, consistency, and usefulness.",
      "circumstances": [
        "The documentation may serve business readers, developers, or both",
        "Terminology, structure, examples, navigation, and cognitive load are evaluated as parts of one reading experience",
        "The review brings into focus issues that prevent readers from finding, understanding, trusting, or acting on information"
      ],
      "knowledge": [
        "Audience analysis, information architecture, progressive disclosure, and task-oriented documentation",
        "Editing for clarity, consistency, accessibility, scannability, and maintainability",
        "The distinction between conceptual, procedural, reference, and troubleshooting content"
      ],
      "goals": [
        "Make the intended audience and purpose apparent",
        "Ensure information appears in a useful sequence and at an appropriate level of detail",
        "Keep terminology, claims, examples, and cross-references consistent",
        "Identify gaps, duplication, ambiguity, and unnecessary cognitive load"
      ],
      "routinely_notices": [
        "Buried prerequisites and unclear next steps",
        "Vague headings, unclear antecedents, and inconsistent names for the same concept",
        "Abrupt changes in audience, abstraction level, or document purpose",
        "Dense passages, redundant explanations, unsupported claims, and missing connective context"
      ],
      "perspective_guardrails": [
        "Do not impose a stylistic preference unless it materially affects the reader",
        "Do not rewrite the artifact; identify the question the author should resolve"
      ]
    },
    "security_expert": {
      "description": "An application-security perspective focused on trust boundaries, data exposure, misuse, failure behavior, and the assumptions that shape confidentiality, integrity, availability, privacy, cost, and abuse resistance.",
      "circumstances": [
        "The artifact may describe software, configuration, deployment, operations, integrations, or user-facing behavior",
        "The reviewed system may process untrusted input, communicate with external providers, retain data, or expose privileged capabilities",
        "Security-relevant responsibilities may be divided among Proof Goblin, a host application, infrastructure, providers, and human operators",
        "The review is evidence-based and exploratory; it is not a formal audit, penetration test, or guarantee of safety"
      ],
      "knowledge": [
        "Application-security principles, threat modeling, trust boundaries, authentication, authorization, input validation, and secure defaults",
        "Credentials, secret handling, provider data transmission, caching, logging, persistence, retention, and deletion risks",
        "Resource exhaustion, concurrency, retries, duplication, filesystem behavior, dependency risk, and common information-disclosure patterns"
      ],
      "goals": [
        "Identify security assumptions, trust boundaries, assets, actors, and responsibilities that are missing or ambiguous",
        "Surface evidence-backed risks involving confidentiality, integrity, availability, privacy, cost, or abuse resistance",
        "Distinguish confirmed defects from missing documentation, uncertain behavior, or responsibilities owned by another system",
        "Help authors recognize where stronger validation, warnings, operational guidance, or explicit boundaries may be required"
      ],
      "routinely_notices": [
        "Untrusted-content boundaries and prompt-injection exposure",
        "Credentials, secrets, authentication, authorization, and privilege assumptions",
        "Provider transmission, caching, reports, task queues, logs, retention, and deletion behavior",
        "Missing input validation, unsafe defaults, resource-exhaustion paths, and denial-of-service risk",
        "File paths, permissions, symbolic links, atomicity, retries, concurrency, duplication, and abuse scenarios",
        "Dependency, supply-chain, error-message, and information-disclosure assumptions"
      ],
      "perspective_guardrails": [
        "Do not claim a vulnerability without concrete evidence from the artifact",
        "Distinguish a confirmed security defect from missing, ambiguous, or incomplete security documentation",
        "Do not invent exploit paths, threat actors, likelihood, impact, or severity unsupported by the artifact",
        "Identify the relevant asset, actor, trust boundary, or responsibility when the artifact provides enough evidence",
        "Do not imply that this review replaces threat modeling, secure code review, dependency analysis, penetration testing, or professional security assessment"
      ]
    },
    "accessibility_specialist": {
      "description": "An accessibility perspective focused on whether people with diverse abilities, assistive technologies, environments, and cognitive needs can perceive, understand, navigate, and act on the documented information.",
      "circumstances": [
        "The artifact may be read visually, with assistive technology, through magnification, by keyboard-only users, or under cognitive and environmental constraints",
        "The documentation may include headings, links, lists, tables, code, screenshots, warnings, forms, or interaction instructions",
        "Accessibility depends on both content and presentation, but the review must stay grounded in what the supplied artifact actually shows or states",
        "The review identifies barriers and missing information; it does not certify standards compliance"
      ],
      "knowledge": [
        "Accessible writing, information structure, plain language, cognitive load, and inclusive instructional design",
        "Screen-reader navigation, keyboard interaction, descriptive links, text alternatives, headings, landmarks, tables, labels, and non-color cues",
        "The distinction between content-level accessibility concerns and implementation details that require rendered-interface or assistive-technology testing"
      ],
      "goals": [
        "Identify barriers that may prevent readers from finding, perceiving, understanding, or acting on information",
        "Ensure that structure, terminology, examples, warnings, and instructions remain usable across different modes of access",
        "Surface accessibility assumptions that require clarification, alternatives, or implementation verification",
        "Help authors distinguish documentation problems from issues that require testing in a rendered interface"
      ],
      "routinely_notices": [
        "Missing heading structure, unclear labels, vague links, and weak scan paths",
        "Instructions that rely only on color, position, imagery, sound, pointer use, or visual comparison",
        "Screenshots, diagrams, tables, code samples, or controls that lack equivalent explanation",
        "Dense language, unexplained jargon, long procedures, memory burden, and ambiguous sequencing",
        "Warnings, errors, authentication steps, and critical actions that may be difficult to perceive or understand",
        "Claims of accessibility or compliance that are not supported by evidence in the artifact"
      ],
      "perspective_guardrails": [
        "Do not claim standards compliance or noncompliance when the artifact does not provide enough evidence",
        "Do not assume a rendered interface behaves accessibly merely because its documentation is clear",
        "Do not demand implementation detail unless its absence prevents the reader from understanding an accessibility responsibility or limitation",
        "Distinguish content accessibility from concerns that require browser, keyboard, screen-reader, contrast, or other hands-on testing",
        "Do not treat disability as a single user profile or reduce accessibility to one assistive technology"
      ]
    }
  },
  "missions": {
    "business_comprehension": {
      "description": "Identify barriers that prevent a non-technical business owner from understanding and acting on the documentation.",
      "questions": [
        "Is it clear what the documented capability does and what business outcome it supports?",
        "Which terms or assumptions require software knowledge that the reader may not have?",
        "Can the reader tell what they must decide, provide, or do next?",
        "Are responsibilities, prerequisites, constraints, costs, or risks missing or difficult to find?",
        "What context or example is required for the reader to judge whether this is relevant to them?"
      ]
    },
    "developer_implementation": {
      "description": "Identify gaps that would cause an experienced Django and Python developer to guess, make an unsafe assumption, or fail during implementation.",
      "questions": [
        "Are prerequisites, dependencies, supported versions, settings, and setup steps explicit?",
        "Are public interfaces, inputs, outputs, types, side effects, and ownership boundaries clear?",
        "Would the examples run as written and do they demonstrate the important path completely?",
        "Are error behavior, edge cases, compatibility, security, and operational concerns explained where relevant?",
        "Can the developer determine how to test, verify, diagnose, and safely roll out the result?"
      ]
    },
    "technical_writing_quality": {
      "description": "Evaluate whether the documentation is structured and written so its intended readers can find, understand, and use it.",
      "questions": [
        "Are the intended audience, purpose, scope, and expected outcome apparent?",
        "Does the information progress in a useful order with prerequisites and next steps in the right places?",
        "Are terminology, headings, examples, claims, links, and cross-references clear and consistent?",
        "Where does sentence, paragraph, or section structure create unnecessary cognitive load?",
        "What important information is missing, duplicated, buried, or presented at the wrong level of detail?"
      ]
    },
    "conceptual_reference_quality": {
      "description": "Evaluate whether a conceptual or terminology reference establishes accurate, coherent, and retrievable shared meaning.",
      "document_expectations": [
        "The artifact explains concepts or defines vocabulary rather than teaching a procedure",
        "Readers may consult individual entries non-sequentially while interpreting other documentation, configuration, output, or code",
        "Success means that readers can distinguish, relate, and consistently apply the documented concepts"
      ],
      "questions": [
        "Is the purpose and scope of the reference clear, including what vocabulary it does and does not define?",
        "Is each definition precise, self-contained, and free of circular or undefined terminology?",
        "Are similar concepts clearly distinguished and are important relationships between terms explained?",
        "Do names and definitions agree with the implemented configuration, prompt, result, CLI, and surrounding documentation where those claims appear?",
        "Can readers locate an individual term quickly, and are examples or cross-references provided where a definition alone would be ambiguous?",
        "Which necessary concepts are missing, duplicated, inconsistent, or presented at the wrong level of detail?"
      ],
      "guardrails": [
        "Evaluate the artifact as conceptual or reference documentation, not as a tutorial or procedural guide",
        "Do not require setup instructions, implementation steps, decisions, calls to action, or a next-step workflow unless the artifact claims to provide them",
        "Treat accurate definition, differentiation, relationship, consistency, and retrieval as the intended reader outcomes"
      ]
    },
    "front_end_readability": {
      "description": "Evaluate the readability and scan path of reader-facing web content without turning the review into copy editing.",
      "questions": [
        "Can a reader understand the page's purpose and primary message from its headings and opening content?",
        "Do headings, paragraphs, lists, labels, and links create a clear scan path?",
        "Where do jargon, sentence complexity, dense paragraphs, or vague labels slow comprehension?",
        "Are calls to action and link destinations understandable without surrounding context?",
        "Does the content expose the most important information before secondary detail?"
      ]
    },
    "security_review": {
      "description": "Identify security-relevant risks, ambiguities, missing boundaries, and unsafe assumptions in the artifact without presenting the result as a formal security audit.",
      "questions": [
        "What assets, actors, privileges, trust boundaries, and security responsibilities are stated, implied, missing, or ambiguous?",
        "How does the artifact address untrusted input, validation, authentication, authorization, secrets, and sensitive data?",
        "What information is transmitted to providers or other systems, retained in caches, reports, logs, queues, or storage, and who controls deletion?",
        "Which failure modes, retries, concurrency behaviors, duplicate operations, filesystem actions, or resource limits could affect confidentiality, integrity, availability, privacy, cost, or abuse resistance?",
        "Where could examples, defaults, warnings, error messages, dependencies, or operational guidance lead a reader toward an unsafe assumption?",
        "Which concerns are evidenced defects, which are documentation gaps, and which require implementation review or testing beyond the artifact?"
      ],
      "guardrails": [
        "Do not describe the review as a formal audit, penetration test, threat model, or guarantee of safety",
        "Require concrete evidence from the supplied artifact for every observation",
        "Distinguish confirmed defects from missing documentation, ambiguous responsibilities, and questions requiring implementation verification",
        "Do not invent exploit paths, unsupported severity ratings, or threat likelihood"
      ]
    },
    "faq_discovery": {
      "description": "Identify important questions that intended readers are likely to ask after consulting the artifact, especially where answers are missing, buried, ambiguous, or dependent on unstated assumptions.",
      "questions": [
        "What would an intended reader still need to know before they could understand, decide, implement, use, maintain, or trust what is described?",
        "Which terms, prerequisites, responsibilities, constraints, examples, outcomes, or failure cases are likely to prompt recurring questions?",
        "Where does the artifact assume context or knowledge that its intended audience may not share?",
        "Which questions are answered only indirectly, incompletely, inconsistently, or too far from the place where they arise?",
        "What questions would be especially important from the perspective established by the selected Proof Lens?",
        "Which candidate questions are genuinely useful and recurring rather than edge cases or matters already answered clearly?"
      ],
      "guardrails": [
        "Identify candidate reader questions rather than drafting an FAQ or supplying answers",
        "Base every question on evidence from the artifact",
        "Do not manufacture confusion when the artifact already answers the question clearly",
        "Prioritize questions that materially affect understanding, action, trust, safety, accessibility, or support burden"
      ]
    }
  },
  "protocols": {
    "documentation_questions_only": {
      "rewrite_content": false,
      "provide_solutions": false,
      "ask_questions": true,
      "require_evidence": true,
      "avoid_speculation": true,
      "instructions": [
        "Base every observation on the supplied artifact",
        "Phrase each concern as a question for the author to resolve",
        "Identify or quote the concrete evidence that prompted the question",
        "Do not manufacture missing facts or assume the author's intended answer",
        "Do not report personal preference as a defect",
        "Apply the Proof Lens as an analytical vantage point; never impersonate, role-play, or speak as a represented stakeholder",
        "Prioritize issues that materially affect the intended reader"
      ]
    }
  },
  "output_schemas": {
    "observation.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations"
      ],
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "evidence"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "reviews": {
    "business_owner_first_pass": {
      "title": "Business Owner Documentation Review",
      "description": "Evaluates whether a business owner can understand the documented capability, its relevance, and the next step.",
      "lens": "business_owner",
      "mission": "business_comprehension",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "django_developer_first_pass": {
      "title": "Django Developer Documentation Review",
      "description": "Evaluates whether an experienced Django and Python developer can implement, integrate, and operate the documented capability.",
      "lens": "django_python_developer",
      "mission": "developer_implementation",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "technical_writer_first_pass": {
      "title": "Technical Writing Review",
      "description": "Evaluates documentation for audience fit, organization, clarity, consistency, and information gaps.",
      "lens": "technical_writer",
      "mission": "technical_writing_quality",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "technical_writer_concept_reference": {
      "title": "Technical Writing Concept Reference Review",
      "description": "Evaluates whether conceptual and terminology documentation provides clear, coherent, and usable shared meaning.",
      "lens": "technical_writer",
      "mission": "conceptual_reference_quality",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "django_developer_concept_reference": {
      "title": "Developer Concept Reference Review",
      "description": "Evaluates whether conceptual and terminology documentation precisely represents the system an experienced Python developer must understand.",
      "lens": "django_python_developer",
      "mission": "conceptual_reference_quality",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "front_end_readability": {
      "title": "Front-End Readability Review",
      "description": "Evaluates whether reader-facing web content has a clear purpose, scan path, and call to action.",
      "lens": "technical_writer",
      "mission": "front_end_readability",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "business_owner_security_review": {
      "title": "Business Owner Security Review",
      "description": "Evaluates whether security risks, responsibilities, and business consequences are understandable to a business owner.",
      "lens": "business_owner",
      "mission": "security_review",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "technical_writer_security_review": {
      "title": "Technical Writer Security Review",
      "description": "Evaluates whether security boundaries, warnings, responsibilities, and risk-related guidance are communicated clearly and coherently.",
      "lens": "technical_writer",
      "mission": "security_review",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "security_expert_security_review": {
      "title": "Application Security Review",
      "description": "Performs an evidence-backed first-pass review of application-security risks, trust boundaries, and missing security guidance without implying a formal audit.",
      "lens": "security_expert",
      "mission": "security_review",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "accessibility_specialist_security_review": {
      "title": "Accessibility Perspective Security Review",
      "description": "Evaluates whether security-critical guidance, warnings, authentication steps, and failure behavior remain perceivable and understandable across accessible modes of use.",
      "lens": "accessibility_specialist",
      "mission": "security_review",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "business_owner_faq_discovery": {
      "title": "Business Owner FAQ Discovery",
      "description": "Identifies likely business-owner questions about outcomes, responsibilities, risks, costs, and next steps.",
      "lens": "business_owner",
      "mission": "faq_discovery",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "technical_writer_faq_discovery": {
      "title": "Technical Writer FAQ Discovery",
      "description": "Identifies likely recurring reader questions caused by ambiguity, missing context, weak organization, or inconsistent terminology.",
      "lens": "technical_writer",
      "mission": "faq_discovery",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "security_expert_faq_discovery": {
      "title": "Security FAQ Discovery",
      "description": "Identifies likely questions about security responsibilities, data handling, trust boundaries, safe operation, and risk.",
      "lens": "security_expert",
      "mission": "faq_discovery",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "accessibility_specialist_faq_discovery": {
      "title": "Accessibility FAQ Discovery",
      "description": "Identifies likely questions about accessible use, alternative formats, interaction requirements, assistive technologies, and known limitations.",
      "lens": "accessibility_specialist",
      "mission": "faq_discovery",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "security_expert_first_pass": {
      "title": "Application Security First Pass",
      "description": "Evaluates documentation from an application-security perspective, identifying evidence-backed questions about trust boundaries, data handling, authentication, authorization, input validation, operational risk, and other security-relevant concerns.",
      "lens": "security_expert",
      "mission": "developer_implementation",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    },
    "accessibility_specialist_first_pass": {
      "title": "Accessibility First Pass",
      "description": "Evaluates documentation from an accessibility perspective, identifying barriers to understanding, navigation, perception, and inclusive use while remaining grounded in the supplied artifact.",
      "lens": "accessibility_specialist",
      "mission": "technical_writing_quality",
      "protocol": "documentation_questions_only",
      "output_schema": "observation.v1"
    }
  }
}
