{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-goblin.local/schemas/review-result.v1.schema.json",
  "title": "Proof Goblin review result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "created_at",
    "review",
    "config",
    "artifact",
    "execution",
    "observations"
  ],
  "properties": {
    "format": {
      "const": "proof-goblin-review-result"
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "description",
        "lens",
        "mission",
        "protocol",
        "output_schema"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "lens": {"type": "string", "minLength": 1},
        "mission": {"type": "string", "minLength": 1},
        "protocol": {"type": "string", "minLength": 1},
        "output_schema": {"type": "string", "minLength": 1}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "media_type", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "response_id", "usage"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "response_id": {"type": ["string", "null"]},
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "total_tokens"],
          "properties": {
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "total_tokens": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "evidence"],
        "properties": {
          "question": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "user"],
      "properties": {
        "system": {"type": "string"},
        "user": {"type": "string"}
      }
    }
  }
}
