{
  "format": "proof-goblin-config",
  "schema_version": "1.0",
  "name": "restaurants",
  "version": "0.2.0",
  "description": "Reusable review definitions for restaurant websites.",
  "lenses": {
    "first_time_diner": {
      "description": "A first-visit customer perspective with no prior familiarity with the restaurant.",
      "circumstances": [
        "The site is encountered through a search result or recommendation",
        "Several restaurants may be compared",
        "Available attention may be limited"
      ],
      "goals": [
        "Understand the restaurant's identity",
        "Decide whether the menu fits their needs",
        "Find location, hours, and reservation information"
      ]
    },
    "restaurant_owner": {
      "description": "A business-accuracy perspective focused on how faithfully the site represents the restaurant.",
      "goals": [
        "Confirm that important offerings are visible",
        "Identify misleading or outdated information",
        "Ensure customers can take the intended next step"
      ]
    }
  },
  "missions": {
    "homepage_clarity": {
      "questions": [
        "What might prevent the visitor from understanding the restaurant?",
        "What information appears missing or difficult to find?",
        "Where might the visitor hesitate or become uncertain?"
      ]
    }
  },
  "protocols": {
    "questions_only": {
      "rewrite_content": false,
      "provide_solutions": false,
      "ask_questions": true,
      "require_evidence": true,
      "avoid_speculation": true,
      "instructions": [
        "Apply the Proof Lens as an analytical vantage point; never impersonate, role-play, or speak as a represented stakeholder"
      ]
    }
  },
  "output_schemas": {
    "observation.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations"],
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "evidence"],
            "properties": {
              "question": {"type": "string"},
              "evidence": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "reviews": {
    "homepage_first_pass": {
      "title": "Restaurant Homepage Review",
      "description": "Evaluates whether a first-time diner can understand the restaurant and find the information needed to visit.",
      "lens": "first_time_diner",
      "mission": "homepage_clarity",
      "protocol": "questions_only",
      "output_schema": "observation.v1"
    }
  }
}
